{
  "name": "corel-tools-suite",
  "version": "1.0.1",
  "description": "Corel Tools Suite - Kumpulan Alat Profesional Otomasi & Desain CorelDRAW",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "prebuild": "powershell -Command \"Stop-Process -Name 'Corel Tools Suite*', 'electron*' -Force -ErrorAction SilentlyContinue\"",
    "prebuild:portable": "powershell -Command \"Stop-Process -Name 'Corel Tools Suite*', 'electron*' -Force -ErrorAction SilentlyContinue\"",
    "prebuild:setup": "powershell -Command \"Stop-Process -Name 'Corel Tools Suite*', 'electron*' -Force -ErrorAction SilentlyContinue\"",
    "build": "\"C:\\Users\\Yahya\\.gemini\\antigravity\\scratch\\cetak-pro-pos\\node_modules\\.bin\\electron-builder.cmd\" --win",
    "build:portable": "\"C:\\Users\\Yahya\\.gemini\\antigravity\\scratch\\cetak-pro-pos\\node_modules\\.bin\\electron-builder.cmd\" --win portable",
    "build:setup": "\"C:\\Users\\Yahya\\.gemini\\antigravity\\scratch\\cetak-pro-pos\\node_modules\\.bin\\electron-builder.cmd\" --win nsis",
    "build:fast": "\"C:\\Users\\Yahya\\.gemini\\antigravity\\scratch\\cetak-pro-pos\\node_modules\\.bin\\electron-builder.cmd\" --win dir",
    "build:keygen": "\"C:\\Users\\Yahya\\.gemini\\antigravity\\scratch\\cetak-pro-pos\\node_modules\\.bin\\electron-builder.cmd\" -c keygen-builder.json --win portable",
    "keygen": "node keygen/generate-key.js",
    "publish:github": "node publish/uploader.js"
  },
  "devDependencies": {
    "electron": "34.5.8"
  },
  "author": "GFX GRAPHIC",
  "license": "ISC",
  "build": {
    "electronVersion": "34.5.8",
    "appId": "com.gfx.coreltoolssuite",
    "productName": "Corel Tools Suite",
    "compression": "normal",
    "directories": {
      "output": "dist-release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "GFX-GRAPHIC",
        "repo": "corel-tools-suite"
      }
    ],
    "files": [
      "src/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "portable": {
      "artifactName": "${productName} ${version} Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Corel Tools Suite",
      "artifactName": "${productName} Setup ${version}.${ext}"
    }
  },
  "dependencies": {
    "chrome-lens-ocr": "^4.1.1",
    "electron-updater": "^6.8.9",
    "google-protobuf": "^3.21.4",
    "image-dimensions": "^2.2.0",
    "set-cookie-parser": "^2.7.1"
  }
}